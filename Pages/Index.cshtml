	<div class="cf-cover-content">
		<div class="container has-text-centered">
			<p class="font-accent is-size-3">Bienvenidos a</p>
			<h1 class="title is-1 is-size-2-mobile">UN HOGAR PARA CADA COLITA</h1>
			<p class="subtitle is-4">Cuidamos, protegemos y acompañamos a perros y gatos que esperan una familia.</p>
			<a class="button is-primary is-medium" href="#ayudar">QUIERO AYUDAR</a>
		</div>
	</div>

	<p class="cf-cover-brand" aria-hidden="true">Colitas Felices</p>
</section>

<section id="cifras" class="cf-stats">
