<!-- MISIÓN Y VISIÓN -->
<section id="nosotros" class="section bg-soft-pink">
    <div class="container">
        <div class="columns is-vcentered is-variable is-8">
            <div class="column is-6">
                <figure class="image is-4by3">
					<img class="cf-img" src="~/img/inicio/compromiso.jpg" alt="Perros y gatos rescatados en el refugio" loading="lazy" />
                </figure>
            </div>
            <div class="column is-6">
                <h2 class="title is-2 cf-title-xl">
                    Nuestro <mark class="cf-highlight"><span class="font-accent cf-script">compromiso</span></mark><br />
                    es darles una segunda oportunidad.
                </h2>
                <p class="is-size-5 mb-5">Detrás de cada colita hay una historia de abandono y una esperanza. Esto es lo que nos mueve cada día.</p>

                <div class="cf-accordion">
                    <details name="mv" open>
                        <summary>Misión</summary>
                        <p>Rescatar y rehabilitar animales en situación de abandono, brindándoles atención veterinaria, cariño y la oportunidad de encontrar una familia responsable.</p>
                    </details>
                    <details name="mv">
                        <summary>Visión</summary>
                        <p>Ser un referente de protección animal en nuestra comunidad, promoviendo la adopción responsable y una sociedad que respete a todos los seres vivos.</p>
                    </details>
                    <details name="mv">
                        <summary>Nuestros valores</summary>
                        <p>Empatía, responsabilidad, transparencia en el uso de los donativos y respeto por la vida animal.</p>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>


<section id="galeria" class="section bg-surface">
	<div class="container">

		@for (var c = 0; c < Model.Categorias.Count; c++)
		{
			var cat = Model.Categorias[c];
			<div class="cf-gallery-block @(c % 2 == 1 ? "is-reverse" : "")" id="galeria-@cat.Id">
				<div class="cf-gallery-head">
					<h3 class="cf-gallery-title">@cat.Titulo</h3>
					<span class="cf-gallery-line" aria-hidden="true"></span>
					<p class="cf-gallery-phrase">@cat.Frase</p>
				</div>
				<div class="cf-bento @(cat.Fotos.Count < 4 ? "is-3" : "")"
					 data-bento
					 data-fotos="@string.Join(",", cat.Fotos)"
					 data-ruta="@Url.Content("~/img/inicio/galeria/")">
					@for (var s = 0; s < Math.Min(4, cat.Fotos.Count); s++)
					{
						<div class="cf-bento-tile cf-bento-@(s + 1)">
							<img src="~/img/inicio/galeria/@(cat.Fotos[s]).webp" alt="@cat.Alt" width="800" height="600" loading="lazy" />
						</div>
					}
				</div>
			</div>
		}
	</div>
</section>

