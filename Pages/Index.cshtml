						<span class="cf-counter" data-target="80" data-prefix="+">+80</span>
					</p>
					<p class="cf-stat-label">Adopciones responsables</p>
				</div>
			</div>

			<div class="column is-4-tablet is-12-mobile" data-aos="fade-up" data-aos-delay="200">
				<div class="cf-stat">
					<p class="cf-stat-number">
						<span class="cf-counter" data-target="8" data-prefix="+">+8</span>
