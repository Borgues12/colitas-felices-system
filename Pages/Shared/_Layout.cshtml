<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Colitas Felices</title>
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Satisfy&family=Sansita+Swashed:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar cf-nav is-fixed-top" role="navigation" aria-label="main navigation">
        <div class="container">
            <div class="navbar-brand">
                <a class="navbar-item has-text-weight-bold" href="/">
                    <img src="~/img/logo/logo.svg" alt="Logo Colitas Felices" class="mr-2" style="max-height: 3.5rem;" />
                </a>
                <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="mainMenu">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </a>
            </div>
            <div id="mainMenu" class="navbar-menu">
                <div class="navbar-end">
                    <a class="navbar-item cf-link" href="/#inicio">Inicio</a>
                    <a class="navbar-item cf-link" href="/#nosotros">Nosotros</a>
                    <a class="navbar-item cf-link" href="/#historia">Historia</a>
                    <a class="navbar-item cf-link" href="/#galeria">Galería</a>
                    <a class="navbar-item cf-link" href="/#ubicacion">Cómo llegar</a>
                    <div class="navbar-item">
                        <a class="button is-primary cf-nav-cta" href="/#ayudar">Cómo ayudar</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main style="padding-top: 3.25rem;">
        @RenderBody()
    </main>

    <!-- Burbuja de ayuda -->
    <aside class="cf-bubble" data-bubble aria-label="Ayuda a Colitas Felices">
        <button type="button" class="delete" aria-label="Cerrar" data-bubble-close></button>
        <div class="cf-bubble-head">
            <img src="~/img/logo/logo_mini.svg" alt="Logo Colitas Felices" class="mr-2" style="max-height: 3rem;" />
            <strong>Colitas Felices</strong>
        </div>
        <div class="cf-typing" data-typing aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="cf-bubble-text">Gracias por llegar hasta aquí. Puedes adoptar, ser voluntario o donar insumos. Cualquier ayuda cambia la vida de una colita.</p>
        <div class="cf-bubble-actions">
            <a class="button is-primary is-small" href="/#ayudar">Cómo ayudar</a>
            <a class="button is-primary is-outlined is-small" target="_blank" rel="noopener"
               href="https://wa.me/593983750246?text=Hola%2C%20quiero%20ayudar%20a%20Colitas%20Felices.">Escribir por WhatsApp</a>
        </div>
    </aside>

    <footer class="cf-footer">
        <div class="cf-footer-body">
            <div class="container">
                <div class="columns is-variable is-6">
                    <div class="column is-5">
                        <div class="cf-footer-logo">
                            <img src="~/img/logo/logo_mini.svg" alt="Logo Colitas Felices" />
                            <span class="cf-footer-brand">Colitas Felices</span>
                        </div>
                        <p>Rescatamos, cuidamos y buscamos hogar para perros y gatos en situación de abandono.</p>
                        <div class="cf-footer-social">
                            <a href="https://www.facebook.com/colitasfelicesecuador" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="https://www.instagram.com/colitasfelicesecuador" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="https://www.tiktok.com/@@colitasfelicesdiana" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>
                    <div class="column is-3">
                        <p class="cf-footer-title">Enlaces</p>
                        <ul>
                            <li><a href="/#inicio">Inicio</a></li>
                            <li><a href="/#historia">Historia</a></li>
                            <li><a href="/#galeria">Galería</a></li>
                            <li><a href="/#ubicacion">Cómo llegar</a></li>
                            <li><a href="/#ayudar">Cómo ayudar</a></li>
                        </ul>
                    </div>
                    <div class="column is-4">
                        <p class="cf-footer-title">Contacto</p>
                        <ul>
                            <li><i class="bi bi-envelope"></i><a href="mailto:candongadiana6@gmail.com">candongadiana6@gmail.com</a></li>
                            <li><i class="bi bi-whatsapp"></i><a href="https://wa.me/593983750246" target="_blank" rel="noopener">098 375 0246</a></li>
                        </ul>
                    </div>
                </div>
                <p class="cf-footer-copy">© @DateTime.Now.Year Fundación Colitas Felices. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/layout.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>